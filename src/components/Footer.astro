---
import {
  ArrowUpIcon as ArrowUp,
} from '@phosphor-icons/react/dist/ssr';
import { getContent, person } from '../i18n';

const c = getContent(Astro.currentLocale);
const year = new Date().getFullYear();
---

<footer class="pb-10">
  <div class="container-page flex flex-col items-start justify-between gap-4 border-t border-line pt-8 text-sm text-muted sm:flex-row sm:items-center">
    <p>© {year} {person.name}. {c.person.location}.</p>
    <a href={`#${c.ids.home}`} class="inline-flex min-h-11 items-center gap-2 transition-colors duration-300 hover:text-ink">
      {c.ui.backToTop}
      <ArrowUp size={16} aria-hidden="true" />
    </a>
  </div>
</footer>
