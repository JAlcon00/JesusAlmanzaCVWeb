---
import {
  SunIcon as Sun,
  MoonIcon as Moon,
  EnvelopeSimpleIcon as EnvelopeSimple,
  TranslateIcon as Translate,
} from '@phosphor-icons/react/dist/ssr';
import { getContent, homePath, mailtoHref, person } from '../i18n';

const c = getContent(Astro.currentLocale);
const other = getContent(c.locale === 'es' ? 'en' : 'es');
// Wordmark estilo identificador: "Jesús.Almanza"
const [first, ...rest] = person.name.split(' ');
const last = rest.join('');
const nav = [
  { href: `#${c.ids.projects}`, label: c.ui.nav.projects },
  { href: `#${c.ids.experience}`, label: c.ui.nav.experience },
  { href: `#${c.ids.stack}`, label: c.ui.nav.stack },
  { href: `#${c.ids.education}`, label: c.ui.nav.education },
];
---

<header class="fixed inset-x-0 top-3 z-(--z-nav) md:top-4">
  <div class="container-page">
    <nav
      aria-label={c.ui.navLabel}
      class="nav-glass relative flex h-14 items-center justify-between gap-3 overflow-hidden rounded-full border border-line pr-1.5 pl-4 md:h-16 md:pr-2 md:pl-6"
    >
      <!-- Progreso de lectura: línea índigo que crece con el scroll de la página -->
      <span
        aria-hidden="true"
        class="nav-progress pointer-events-none absolute inset-x-6 bottom-0 h-px bg-accent"
      ></span>
      <!-- Wordmark: el nombre escrito como identificador de código (Jesús.Almanza) con cursor de terminal -->
      <a href={`#${c.ids.home}`} class="wordmark flex min-h-11 items-center" data-wordmark>
        <span class="sr-only">{person.name}</span>
        <span
          aria-hidden="true"
          class="flex items-baseline font-mono text-[15px] font-bold tracking-[-0.04em] whitespace-nowrap sm:text-[17px]"
        >
          <span data-scramble={first}>{first}</span>
          <span class="wordmark-dot text-accent-ink">.</span>
          <span data-scramble={last}>{last}</span>
          <span class="wordmark-caret"></span>
        </span>
      </a>

      <ul class="hidden items-center gap-1 lg:flex">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              data-nav-link
              class="inline-flex min-h-11 items-center rounded-full px-4 text-sm text-muted transition-colors duration-300 hover:bg-surface hover:text-ink aria-[current=true]:bg-surface aria-[current=true]:text-ink"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <div class="flex items-center gap-1.5">
        <a
          href={homePath(other.locale)}
          hreflang={other.htmlLang}
          lang={other.htmlLang}
          aria-label={c.ui.switchLang.aria}
          class="inline-flex min-h-11 min-w-11 items-center justify-center gap-1.5 rounded-full px-2.5 font-mono text-xs font-medium text-muted sm:px-3 transition-colors duration-300 hover:bg-surface hover:text-ink"
        >
          <Translate size={18} aria-hidden="true" className="hidden sm:block" />
          {c.ui.switchLang.short}
        </a>
        <button
          type="button"
          data-theme-toggle
          data-label-dark={c.ui.themeToDark}
          data-label-light={c.ui.themeToLight}
          aria-label={c.ui.themeToDark}
          class="grid size-11 place-items-center rounded-full text-muted transition-colors duration-300 hover:bg-surface hover:text-ink"
        >
          <Moon size={20} aria-hidden="true" className="dark:hidden" />
          <Sun size={20} aria-hidden="true" className="hidden dark:block" />
        </button>
        <a
          href={mailtoHref(c)}
          data-magnetic
          class="inline-flex min-h-11 items-center gap-2 rounded-full bg-btn px-4 text-sm sm:px-5 font-medium whitespace-nowrap text-btn-ink transition-[background-color,transform] duration-300 hover:bg-btn-hover active:scale-[0.98]"
        >
          <EnvelopeSimple size={18} aria-hidden="true" className="block min-[421px]:max-sm:hidden" />
          <span class="max-[420px]:sr-only">{c.ui.cta.contact}</span>
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  // Wordmark: al pasar el cursor o enfocar, las letras se decodifican como datos (mismo efecto que el eyebrow del hero).
  const wordmark = document.querySelector<HTMLElement>('[data-wordmark]');
  const calmMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (wordmark && !calmMotion) {
    const parts = [...wordmark.querySelectorAll<HTMLElement>('[data-scramble]')];
    const glyphs = '01<>/_#%&*+=abcdef';
    let running = false;
    const scramble = () => {
      if (running) return;
      running = true;
      const duration = 520;
      let start = 0;
      const tick = (now: number) => {
        if (!start) start = now;
        const progress = Math.min(1, (now - start) / duration);
        parts.forEach((el) => {
          const target = el.dataset.scramble ?? '';
          const revealed = Math.floor(progress * target.length);
          el.textContent = [...target]
            .map((ch, i) => (i < revealed ? ch : glyphs[Math.floor(Math.random() * glyphs.length)]))
            .join('');
        });
        if (progress < 1) requestAnimationFrame(tick);
        else {
          parts.forEach((el) => (el.textContent = el.dataset.scramble ?? ''));
          running = false;
        }
      };
      requestAnimationFrame(tick);
    };
    wordmark.addEventListener('pointerenter', scramble);
    wordmark.addEventListener('focus', scramble);
  }

  // Sección activa en la nav (orientación): IntersectionObserver, sin listeners de scroll.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  const targets = links
    .map((a) => document.querySelector<HTMLElement>(a.getAttribute('href') ?? ''))
    .filter((el): el is HTMLElement => !!el);
  if (targets.length) {
    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!visible) return;
        links.forEach((a) => {
          const on = a.getAttribute('href') === `#${visible.target.id}`;
          if (on) a.setAttribute('aria-current', 'true');
          else a.removeAttribute('aria-current');
        });
      },
      { rootMargin: '-40% 0px -50% 0px', threshold: [0, 0.1, 0.5] },
    );
    targets.forEach((t) => io.observe(t));
  }

  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const root = document.documentElement;

  const sync = () => {
    const isDark = root.dataset.theme === 'dark';
    const label = isDark ? button?.dataset.labelLight : button?.dataset.labelDark;
    if (label) button?.setAttribute('aria-label', label);
  };
  sync();

  button?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch (_) {
      /* almacenamiento bloqueado: el tema aplica solo en esta visita */
    }
    sync();
  });
</script>

<style>
  /* Cursor de terminal del wordmark: bloque índigo que parpadea en pasos (sin easing) */
  .wordmark-caret {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    margin-left: 0.12em;
    translate: 0 0.16em;
    border-radius: 1px;
    background: var(--accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .wordmark-caret {
      animation: caret-blink 1.1s steps(1, end) infinite;
    }
  }
  @keyframes caret-blink {
    50% {
      opacity: 0;
    }
  }
  .wordmark:hover .wordmark-dot,
  .wordmark:focus-visible .wordmark-dot {
    color: var(--mint-ink);
  }

  /* Vidrio esmerilado (aproximación web, no Liquid Glass oficial de Apple) */
  .nav-glass {
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    backdrop-filter: blur(18px) saturate(160%);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.06),
      0 12px 32px -18px rgb(var(--shadow-tint) / 0.35);
  }
  @media (prefers-reduced-transparency: reduce) {
    .nav-glass {
      background: var(--bg);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
</style>
